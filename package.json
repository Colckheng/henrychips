{
  "name": "personal-workstation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "glob": "14.0.3",
    "minimatch": "11.0.4"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch src/adapters/http/server.ts --dev\" \"vite --host 127.0.0.1\"",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.tests.json",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/adapters/http/server.js",
    "cli": "tsx src/adapters/cli/main.ts",
    "mcp": "tsx src/adapters/mcp/main.ts",
    "test": "tsx --test tests/core/*.test.ts tests/tools/*.test.ts tests/adapters/*.test.ts",
    "test:production": "tsx --test tests/production.test.ts",
    "test:web": "tsx --tsconfig tsconfig.web.json --test tests/e2e/*.unit.ts tests/e2e/*.unit.tsx",
    "test:e2e": "playwright test",
    "samples": "tsx scripts/create-samples.ts"
  },
  "dependencies": {
    "@fastify/static": "10.1.8",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "abogus": "2.1.1",
    "csv-parse": "7.0.3",
    "docx": "9.15.1",
    "exceljs": "4.4.0",
    "fastify": "5.12.7",
    "ipaddr.js": "2.5.0",
    "linkedom": "0.18.15",
    "lucide-react": "1.66.0",
    "mammoth": "1.13.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "playwright-core": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "undici": "7.30.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "10.6.2",
    "concurrently": "9.2.5",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.17",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
